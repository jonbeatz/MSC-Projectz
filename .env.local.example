# Copy to `.env.local` (gitignored) for local SMTP + verification testing.
#
# CRITICAL split:
# • Local development: NEXT_PUBLIC_SITE_URL must be your dev origin so verify links match the tab you open.
#   Example: http://127.0.0.1:3000 — use ONE of 127.0.0.1 OR localhost consistently (cookies).
# • Production (later, cPanel Node env ONLY): NEXT_PUBLIC_SITE_URL=https://jon-beatz.com
#
# Do not paste this file verbatim onto the server; live secrets belong in the host env UI.

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

DEV_BYPASS_ENABLED=true

MSC_STUDIO_OUTGOING_HOST=mail.spacemail.com
MSC_STUDIO_OUTGOING_PORT=465
MSC_STUDIO_OUTGOING_SSL=true
MSC_STUDIO_OUTGOING_USER=your-full-mailbox@yourdomain.com
MSC_STUDIO_OUTGOING_PASS=your-app-password-from-mail-dashboard
# Optional — MSC_STUDIO_OUTGOING_FROM="MSC Studio <your-full-mailbox@yourdomain.com>"
