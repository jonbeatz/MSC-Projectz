PAYLOAD_SECRET=replace-with-a-long-random-string
DATABASE_URI=file:./payload.sqlite
# Must match the public origin (verification links, cookies). Production example: https://jon-beatz.com
NEXT_PUBLIC_SITE_URL=https://example.com

# Outbound SMTP for verification, resend-verification, welcome mail, and task notifications (nodemailer).
# Spaceship Spacemail: host mail.spacemail.com, port 465, SSL. Use a mailbox + app password from the mail dashboard.
# On cPanel, prefer Node.js Application Manager → Environment Variables (not only a checked-in .env).
MSC_STUDIO_OUTGOING_HOST=mail.spacemail.com
MSC_STUDIO_OUTGOING_PORT=465
MSC_STUDIO_OUTGOING_USER=
MSC_STUDIO_OUTGOING_PASS=
MSC_STUDIO_OUTGOING_SSL=true
# Optional From header (nodemailer). If unset, MSC_STUDIO_OUTGOING_USER is used when it looks like an email.
# MSC_STUDIO_OUTGOING_FROM="MSC Studio <noreply@yourdomain.com>"

DEV_BYPASS_ENABLED=false

# Sentry error monitoring (optional, leave empty to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
